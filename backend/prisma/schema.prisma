generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

// Subscription plan tiers
// SILVER = 2 credits/week, GOLD = 3 credits/week, UNLIMITED = no limit
enum SubscriptionTier {
  SILVER
  GOLD
  UNLIMITED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  // Role — "USER" (default) or "ADMIN". Set via admin seed script or promote endpoint.
  role         String       @default("USER")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdGames        Game[]              @relation("GameCreator")
  gameMemberships     GamePlayer[]
  subscriptions       UserSubscription[]
  payments            Payment[]
  instructorBookings  InstructorBooking[]

  @@map("users")
}


model Stadium {
  id                      String   @id @default(uuid())
  name                    String
  description             String
  location                String
  address                 String?
  latitude                Float?
  longitude               Float?
  sport                   String
  imageUrl                String
  selectedPhotoUrl        String?
  selectedPhotoAttribution String?
  rating                  Float?
  placeId                 String?
  price                   Float
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  games                   Game[]

  @@map("stadiums")
}

model Game {
  id                      String     @id @default(uuid())
  stadiumId               String
  creatorId               String
  title                   String     @default("Sports Match")
  date                    DateTime
  startTime               String     // Format: "HH:mm" (e.g. "20:00")
  endTime                 String     // Format: "HH:mm" (e.g. "22:00")
  maxPlayers              Int        @default(10)
  selectedPhotoUrl        String?
  selectedPhotoAttribution String?
  status                  GameStatus @default(UPCOMING)
  // Payment method used when booking: "CASH" | "CARD" | null
  paymentMethod           String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  stadium   Stadium    @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  creator   User       @relation("GameCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  players   GamePlayer[]
  payment   Payment?

  // Prevent duplicate bookings at identical start times for the same stadium and date
  @@unique([stadiumId, date, startTime])
  @@map("games")
}

model GamePlayer {
  id               String            @id @default(uuid())
  gameId           String
  userId           String
  joinedAt         DateTime          @default(now())
  // Link to subscription credit used for this booking (null = paid individually)
  subscriptionId   String?

  game             Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription     UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([gameId, userId])
  @@map("game_players")
}

// A user's subscription record
model UserSubscription {
  id               String             @id @default(uuid())
  userId           String
  tier             SubscriptionTier
  status           SubscriptionStatus @default(ACTIVE)
  durationMonths   Int
  startDate        DateTime           @default(now())
  endDate          DateTime
  // Price paid in GEL (stored for record-keeping)
  pricePaid        Float
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyUsages     WeeklyUsage[]
  gamePlayers      GamePlayer[]

  @@map("user_subscriptions")
}

// Tracks how many credits a subscription has used in a given ISO week
model WeeklyUsage {
  id               String           @id @default(uuid())
  subscriptionId   String
  // ISO week key: "YYYY-WNN" e.g. "2026-W42"
  weekKey          String
  creditsUsed      Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  subscription     UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, weekKey])
  @@map("weekly_usages")
}

// Payment record for a stadium game booking or instructor session
model Payment {
  id                  String    @id @default(uuid())
  userId              String
  // One of these will be set depending on payment type
  gameId              String?   @unique
  instructorBookingId String?   @unique
  amount              Float
  // "CASH" | "CARD"
  method              String    @default("CASH")
  // "PENDING" | "COMPLETED" | "FAILED" | "REFUNDED"
  status              String    @default("PENDING")
  // External transaction reference (e.g. from payment provider). Null for simulated/cash.
  transactionRef      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)
  instructorBooking   InstructorBooking? @relation(fields: [instructorBookingId], references: [id], onDelete: SetNull)

  @@map("payments")
}

// Instructor lesson booking
model InstructorBooking {
  id             String   @id @default(uuid())
  userId         String
  // Identifier of the instructor (from constants — not a DB user for now)
  instructorId   String
  instructorName String
  sport          String
  // "1-on-1" | "Group Coaching"
  lessonType     String
  // The time slot selected (e.g. "Mon 10:00-11:00")
  slot           String
  amount         Float
  // "PENDING" | "CONFIRMED" | "CANCELLED"
  status         String   @default("PENDING")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment?

  @@map("instructor_bookings")
}
