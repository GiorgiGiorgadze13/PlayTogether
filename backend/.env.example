# ── Local Development ──────────────────────────────────────────
# SQLite (local only)
DATABASE_URL="file:./dev.db"
PORT=5000
NODE_ENV=development
JWT_SECRET="super-secret-jwt-key-playtogether-2026"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# ── Production (Railway) ───────────────────────────────────────
# Railway auto-injects DATABASE_URL when you add a PostgreSQL plugin.
# Set these in Railway → your service → Variables tab:
#
# DATABASE_URL=postgresql://...  (auto-set by Railway Postgres plugin)
# PORT=5000
# NODE_ENV=production
# JWT_SECRET=<your-strong-secret>
# JWT_EXPIRES_IN=7d
# CORS_ORIGIN=https://your-app.vercel.app

# Optional: Google Places API Key for real venue search and photos
# GOOGLE_PLACES_API_KEY="AIzaSyYourKeyHere"
