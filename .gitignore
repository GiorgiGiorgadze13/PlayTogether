logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ───────────────────────────────────────────────
# Dependencies
# ───────────────────────────────────────────────
node_modules/

# ───────────────────────────────────────────────
# Build output
# ───────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ───────────────────────────────────────────────
# Environment files — NEVER commit real secrets
# ───────────────────────────────────────────────
.env
.env.*
# Allow the example template
!.env.example

# ───────────────────────────────────────────────
# SQLite / Prisma local databases
# Keep schema.prisma AND migrations tracked.
# Only ignore the binary database files.
# ───────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/prisma/dev.db
backend/prisma/dev.db.backup

# ───────────────────────────────────────────────
# Test & Coverage
# ───────────────────────────────────────────────
coverage/
.nyc_output/

# ───────────────────────────────────────────────
# Cache directories
# ───────────────────────────────────────────────
.cache/
.vite/
.turbo/
.eslintcache
.oxlintcache

# ───────────────────────────────────────────────
